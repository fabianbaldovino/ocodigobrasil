# Normaliza finais de linha: o repositório guarda LF; no Windows o checkout pode usar CRLF.
* text=auto

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Scripts .cmd do Windows precisam de CRLF; o launcher sh precisa de LF.
*.cmd text eol=crlf
.claude/skills/impeccable/scripts/impeccable text eol=lf
