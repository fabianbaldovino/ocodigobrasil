rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Formato de slug dos artigos (content/artigos/<slug>.md). Validar pelo
    // formato, e não por uma lista fixa, evita ter que atualizar as regras a
    // cada artigo novo; o comentário só aparece depois de aprovado.
    function validSlug(s) {
      return s is string && s.matches('^[a-z0-9]+(-[a-z0-9]+)*$') && s.size() <= 100;
    }

    function validTimestamp(t) {
      return t == request.time;
    }

    // Comentários — leitura pública apenas dos aprovados,
    // criação validada (entram como "pending"), moderação via console/Admin
    match /comments/{commentId} {
      allow read: if resource.data.status == 'approved';

      allow create: if validSlug(request.resource.data.slug)
        && request.resource.data.keys().hasOnly(['slug', 'name', 'text', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && request.resource.data.text.size() <= 1000
        && validTimestamp(request.resource.data.createdAt);

      allow update, delete: if false;
    }

    // Qualquer outro caminho (inclusive a antiga coleção ratings) fica fechado.
  }
}
