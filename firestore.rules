rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function validSlug(s) {
      return s in ['como-a-rua-destroi-suas-vendas', 'culto-do-suor-crossfit', 'mini-dicionario-codigo-brasil', 'o-case-havaianas', 'o-fenomeno-carmed-fini', 'o-fenomeno-nubank', 'politica-e-eleicoes-2026'];
    }

    function validDevice(id) {
      return id is string && id.matches('^[A-Za-z0-9_-]{8,64}$');
    }

    function validTimestamp(t) {
      return t == request.time;
    }

    function validateRatingCreate(req, slug) {
      let voter = req.lastVoter;
      let ref = /databases/$(database)/documents/ratings/$(slug)/votes/$(voter);
      let newScore = existsAfter(ref) ? getAfter(ref).data.score : 0;

      return newScore > 0
        && req.count == 1
        && req.sum == newScore
        && req.sum >= 1
        && req.sum <= 5
        && req.avg >= req.sum - 0.01
        && req.avg <= req.sum + 0.01
        && req.avg >= 1
        && req.avg <= 5;
    }

    function validateRatingUpdate(req, res, slug) {
      let voter = req.lastVoter;
      let ref = /databases/$(database)/documents/ratings/$(slug)/votes/$(voter);
      let oldScore = exists(ref) ? get(ref).data.score : 0;
      let newScore = existsAfter(ref) ? getAfter(ref).data.score : 0;
      
      return newScore > 0
        && req.sum == res.sum - oldScore + newScore
        && req.count == res.count + (oldScore == 0 ? 1 : 0)
        && req.count >= 1
        && req.sum >= req.count
        && req.sum <= req.count * 5
        && req.avg >= ((req.sum * 1.0 / req.count) - 0.01)
        && req.avg <= ((req.sum * 1.0 / req.count) + 0.01)
        && req.avg >= 1
        && req.avg <= 5;
    }

    function validateVoteAcoplamento(slug, deviceId) {
      let ref = /databases/$(database)/documents/ratings/$(slug);
      let parent = existsAfter(ref) ? getAfter(ref).data : null;
      return parent != null 
        && parent.updatedAt == request.time
        && parent.lastVoter == deviceId;
    }

    match /ratings/{slug} {
      allow read: if true;

      allow create: if validSlug(slug)
        && request.resource.data.keys().hasOnly(['count', 'sum', 'avg', 'updatedAt', 'lastVoter'])
        && validDevice(request.resource.data.lastVoter)
        && validTimestamp(request.resource.data.updatedAt)
        && validateRatingCreate(request.resource.data, slug);

      allow update: if validSlug(slug)
        && request.resource.data.keys().hasOnly(['count', 'sum', 'avg', 'updatedAt', 'lastVoter'])
        && validDevice(request.resource.data.lastVoter)
        && validTimestamp(request.resource.data.updatedAt)
        && validateRatingUpdate(request.resource.data, resource.data, slug);

      allow delete: if false;

      match /votes/{deviceId} {
        allow read: if validDevice(deviceId);
        allow create, update: if validDevice(deviceId)
          && request.resource.data.keys().hasOnly(['score', 'updatedAt'])
          && request.resource.data.score is int
          && request.resource.data.score >= 1
          && request.resource.data.score <= 5
          && validTimestamp(request.resource.data.updatedAt)
          && validateVoteAcoplamento(slug, deviceId);
        allow delete: if false;
      }
    }

    // Comentários — leitura pública apenas dos aprovados,
    // criação validada (entram como "pending"), moderação via console/Admin
    match /comments/{commentId} {
      allow read: if resource.data.status == 'approved';

      allow create: if validSlug(request.resource.data.slug)
        && request.resource.data.keys().hasOnly(['slug', 'name', 'text', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 60
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 2
        && request.resource.data.text.size() <= 1000
        && validTimestamp(request.resource.data.createdAt);

      allow update, delete: if false;
    }
  }
}
